# Claves de API para la etapa 1 (generar). Copia este archivo como .env y completa las claves.
# .env no se sube a GitHub (está en .gitignore); .env.example sí, como plantilla.

# OpenAI: clave de la plataforma de API (platform.openai.com → proyecto → API keys), no de ChatGPT.
# Empieza con sk-proj-
OPENAI_API_KEY=

# Gemini (Google AI Studio → Get API key). Opcional: solo para comparar proveedores.
GEMINI_API_KEY=
